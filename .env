# --- AWS & S3 CONFIGURATION ---
# The target S3 bucket name where zipped daily files will be uploaded
S3_BUCKET_NAME=hashkey-data-collect-620972496439-ap-east-1-an

# AWS Region of your S3 Bucket
S3_REGION=ap-east-1

# Optional: AWS Access Keys. 
# Leave blank to use IAM Role on EC2 or local AWS config.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prefix/folder inside the S3 bucket where archives are saved (include the trailing slash)
S3_PREFIX=crypto-market-data/

# --- LOCAL DIRECTORIES ---
# Local directory inside container where active data is cached
LOCAL_DATA_DIR=./local_cache

# --- TIMING CONFIGURATION ---
# Buffer in minutes after UTC midnight before zipping and uploading the completed day's files
UPLOAD_DELAY_MINUTES=5

# --- OSL EXCHANGE CONFIGURATION ---
OSL_API_KEY=79a8b4dc-5c77-407b-a004-31ee171c5d9c
OSL_API_SECRET=wXg+ZAZ4F68RzT64HiKWK4ucECCp/McbgQrSf/J8X6NNrVgtqHQDu7KRDy00Ei/UPA0pZxppGZNr3KZhWFUnkQ==
OSL_REST_URL=https://api.osl.com
OSL_FIX_HOST=fix.osl.com
OSL_FIX_PORT=443
OSL_FIX_SENDER_COMP_ID=79a8b4dc-5c77-407b-a004-31ee171c5d9c
OSL_FIX_TARGET_COMP_ID=OSL

