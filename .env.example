# --- AWS & S3 CONFIGURATION ---
S3_BUCKET_NAME=your-market-data-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=crypto-market-data/

# --- LOCAL DIRECTORIES ---
LOCAL_DATA_DIR=/app/local_cache

# --- TIMING CONFIGURATION ---
UPLOAD_DELAY_MINUTES=5

# --- TARGET SYMBOLS PER EXCHANGE (OPTIONAL OVERRIDES) ---
# HASHKEY_GLOBAL_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,BTCUSD-PERPETUAL
# HASHKEY_HK_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,BTCUSD-PERPETUAL,BTCUSD,BTCUSDT,ETHUSD,ETHUSDT,SOLUSD,AVAXUSD,XRPUSD,LINKUSD,ARBUSD
# HASHKEY_MENA_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,SKHYNIXUSDT-PERPETUAL,QQQUSDT-PERPETUAL,SPCXUSDT-PERPETUAL,SOXLUSDT-PERPETUAL,USDTUSDC
# BITGET_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,BTCUSD-PERPETUAL
# GATE_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,BTCUSD-PERPETUAL
# OSL_TARGET_SYMBOLS=BTCUSDC,USDTUSD

# --- OSL EXCHANGE CONFIGURATION ---
OSL_API_KEY=your_osl_api_key
OSL_API_SECRET=your_osl_api_secret
OSL_REST_URL=https://api.osl.com
OSL_WS_URL=wss://stream-api.osl.com/openapi/v1/ws
