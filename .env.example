# --- AWS & S3 CONFIGURATION ---
S3_BUCKET_NAME=your-market-data-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=crypto-market-data/

# --- LOCAL DIRECTORIES ---
LOCAL_DATA_DIR=/app/local_cache

# --- APPLICATION LOGS ---
# One file per UTC day (app_YYYY-MM-DD.log), split early at LOG_MAX_FILE_MB, deleted after LOG_RETENTION_DAYS.
# The oldest files are also deleted once all logs together exceed LOG_MAX_TOTAL_MB.
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_MB=100
LOG_MAX_TOTAL_MB=2000

# --- TELEGRAM ALERTS ---
# Alerts are off unless both are set. Send /start to the bot first, then read the numeric chat id from
# https://api.telegram.org/bot<token>/getUpdates (result[].message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Name shown on every alert (defaults to the host name, which is the container id under Docker)
ALERT_INSTANCE_NAME=ec2-collector
# The same alert (ignoring numbers) is repeated at most once per this many minutes
TELEGRAM_ALERT_COOLDOWN_MINUTES=60
# Alert when a configured symbol has written no data for this many minutes
STALE_DATA_ALERT_MINUTES=5

# --- TIMING CONFIGURATION ---
UPLOAD_DELAY_MINUTES=5

# Target symbols are NOT configured here; edit config.py (ADR 0010).

# --- OSL EXCHANGE CONFIGURATION ---
OSL_REST_URL=https://trade-hk.osl.com/api/v5
OSL_WS_URL=wss://stream-hk.osl.com/ws/v5/public

# --- PANTHER EXCHANGE CONFIGURATION ---
# All Panther WebSocket and REST access is authenticated (View permission is enough). The key must whitelist this server's IP.
# The collector is skipped with a warning when any of the three credentials is empty.
PANTHER_API_KEY=
PANTHER_API_SECRET=
PANTHER_PASSPHRASE=
PANTHER_REST_URL=https://web-api.panthertrade.com
PANTHER_WS_URL=wss://ws-api.panthertrade.com/v1
