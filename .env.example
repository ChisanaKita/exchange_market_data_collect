# --- AWS & S3 CONFIGURATION ---
S3_BUCKET_NAME=your-market-data-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=crypto-market-data/

# --- LOCAL DIRECTORIES ---
LOCAL_DATA_DIR=/app/local_cache

# --- TIMING CONFIGURATION ---
UPLOAD_DELAY_MINUTES=5

# --- TARGET SYMBOLS PER EXCHANGE (OPTIONAL OVERRIDES) ---
# Use each exchange's NATIVE symbol names; they are used verbatim (no translation) and name the output folders.
# HASHKEY_GLOBAL_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL
# HASHKEY_HK_TARGET_SYMBOLS=BTCUSD,BTCUSDT,ETHUSD,ETHUSDT,SOLUSD,AVAXUSD,XRPUSD,LINKUSD,ARBUSD,USDTUSD,USDTHKD
# HASHKEY_MENA_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,SKHYNIXUSDT-PERPETUAL,QQQUSDT-PERPETUAL,SPCXUSDT-PERPETUAL,SOXLUSDT-PERPETUAL,USDTUSDC,USDTAED
# BITGET_TARGET_SYMBOLS=BTCUSDT,ETHUSDT
# GATE_TARGET_SYMBOLS=BTC_USDT,ETH_USDT,BTC_USD
# OSL_TARGET_SYMBOLS=BTCUSD,USDTUSD

# --- OSL EXCHANGE CONFIGURATION ---
OSL_API_KEY=your_osl_api_key
OSL_API_SECRET=your_osl_api_secret
OSL_REST_URL=https://trade-hk.osl.com/api/v5
OSL_WS_URL=wss://stream-hk.osl.com/ws/v5/public
