# --- AWS & S3 CONFIGURATION ---
S3_BUCKET_NAME=your-market-data-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=crypto-market-data/

# --- LOCAL DIRECTORIES ---
LOCAL_DATA_DIR=/app/local_cache

# --- APPLICATION LOGS ---
# One file per UTC day (app_YYYY-MM-DD.log), split early at LOG_MAX_FILE_MB, deleted after LOG_RETENTION_DAYS.
# The oldest files are also deleted once all logs together exceed LOG_MAX_TOTAL_MB.
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_MB=100
LOG_MAX_TOTAL_MB=2000

# --- TELEGRAM ALERTS ---
# Alerts are off unless both are set. Send /start to the bot first, then read the numeric chat id from
# https://api.telegram.org/bot<token>/getUpdates (result[].message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Name shown on every alert (defaults to the host name, which is the container id under Docker)
ALERT_INSTANCE_NAME=ec2-collector
# The same alert (ignoring numbers) is repeated at most once per this many minutes
TELEGRAM_ALERT_COOLDOWN_MINUTES=60
# Alert when a configured symbol has written no data for this many minutes
STALE_DATA_ALERT_MINUTES=5

# --- TIMING CONFIGURATION ---
UPLOAD_DELAY_MINUTES=5

# --- TARGET SYMBOLS PER EXCHANGE (OPTIONAL OVERRIDES) ---
# Use each exchange's NATIVE symbol names; they are used verbatim (no translation) and name the output folders.
# HASHKEY_GLOBAL_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL
# HASHKEY_HK_TARGET_SYMBOLS=BTCUSD,BTCUSDT,ETHUSD,ETHUSDT,SOLUSD,AVAXUSD,XRPUSD,LINKUSD,ARBUSD,USDTUSD,USDTHKD
# HASHKEY_MENA_TARGET_SYMBOLS=BTCUSDT-PERPETUAL,ETHUSDT-PERPETUAL,SKHYNIXUSDT-PERPETUAL,QQQUSDT-PERPETUAL,SPCXUSDT-PERPETUAL,SOXLUSDT-PERPETUAL,USDTUSDC,USDTAED
# Bitget has one list per market (ADR 0009). Perps: "_CM" = coin-margined (v3 WS), "PERP" = USDC-margined, else USDT-margined.
# BITGET_SPOT_TARGET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,ADAUSDT,TRXUSDT,NEARUSDT,SUIUSDT,BGBUSDT,USDCUSDT,USDGOUSDT,DOGEUSDT,PEPEUSDT,XAUTUSDT,ZECUSDT,HYPEUSDT,WLDUSDT,ENAUSDT
# BITGET_PERP_TARGET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,HYPEUSDT,HYPEPERP,NEARUSDT,LISTAUSDT,BTCUSD_CM,NVDAUSDT,TSLAUSDT,AAPLUSDT,METAUSDT,AMZNUSDT,MSTRUSDT,PLTRUSDT,HONHAIUSDT,MEDIATEKUSDT,OPENAIUSDT,BZUSDT,CLUSDT,NATGASUSDT,DXYUSDT,TQQQUSDT,SKHYNIXUSDT
# GATE_TARGET_SYMBOLS=BTC_USDT,ETH_USDT,BTC_USD
# OSL_TARGET_SYMBOLS=BTCUSD,USDTUSD
# PANTHER_TARGET_SYMBOLS=USDT-USD,USDT-HKD,BTC-USD,ETH-USD

# --- OSL EXCHANGE CONFIGURATION ---
OSL_REST_URL=https://trade-hk.osl.com/api/v5
OSL_WS_URL=wss://stream-hk.osl.com/ws/v5/public

# --- PANTHER EXCHANGE CONFIGURATION ---
# All Panther WebSocket and REST access is authenticated (View permission is enough). The key must whitelist this server's IP.
# The collector is skipped with a warning when any of the three credentials is empty.
PANTHER_API_KEY=
PANTHER_API_SECRET=
PANTHER_PASSPHRASE=
PANTHER_REST_URL=https://web-api.panthertrade.com
PANTHER_WS_URL=wss://ws-api.panthertrade.com/v1
